#!/usr/bin/zsh

theme_name=$1

# Yolk templates.
YOLK_THEME=${theme_name} yolk sync

# Background.
# The comma is necessary to omit the monitor argument.
hyprctl hyprpaper wallpaper , ~/pictures/backgrounds/${theme_name}

# Foot does not support reloading the config, however it does support theme
# switching by way of user signals.
if [[ $theme_name = "dark" ]]; then
    pkill --signal USR1 foot
else
    pkill --signal USR2 foot
fi

# Tmux.
tmux source-file ~/.config/tmux/tmux.conf
