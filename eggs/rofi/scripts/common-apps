#!/usr/bin/zsh

terminal='[t]erminal'
browser='[b]rowser'
steam='[s]team'
discord='[d]iscord'
music='[m]usic'
files='[f]iles'
selected_option=$(rofi-menu "frequently used applications" $terminal $browser $steam $discord $music $files)

case $selected_option in
    $terminal)
        hyprctl --batch eval "hl.config({ binds = { workspace_back_and_forth = 0 }});" \
            dispatch "hl.dsp.focus({ workspace = 1 });" \
            dispatch 'hl.dsp.exec_cmd("footclient tmux new-session -A -s default");' \
            eval "hl.config({ binds = { workspace_back_and_forth = 1 }})"
        ;;
    $browser)
        zen-browser
        ;;
    $steam)
        steam
        ;;
    $discord)
        webcord
        ;;
    $music)
        spotify-launcher
        ;;
    $files)
        footclient yazi
        ;;
esac
