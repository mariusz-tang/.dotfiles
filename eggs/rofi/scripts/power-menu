#!/usr/bin/zsh

poweroff='[p]oweroff'
reboot='[r]eboot'
lock='[l]ock'
exit="[e]xit hyprland"
selected_option=$(rofi-menu "power options" $poweroff $reboot $lock $exit)

case $selected_option in
    $poweroff)
        poweroff
        ;;
    $reboot)
        reboot
        ;;
    $lock)
        # Allow the rofi window to disappear before locking.
        sleep 0.1
        hyprlock
        ;;
    $exit)
        command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'
        ;;
esac
