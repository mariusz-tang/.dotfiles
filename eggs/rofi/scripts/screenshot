#!/usr/bin/zsh

everything='[e]verything'
window='[w]indow'
display='[d]isplay'
rectangle='[r]ectangle'
colorpicker='[c]olorpicker'
selected_option=$(rofi-menu screenshot $everything $window $display $rectangle $colorpicker)

# Wait for rofi window closing animation to finish.
sleep 0.16

timestamp-filename() {
    echo $(date +%Y-%m-%d_%H-%M-%S).png
}

case $selected_option in
    $everything)
        grim - | tee ~/pictures/screenshots/$(timestamp-filename) | wl-copy
        ;;
    $window)
        active_window=$(hyprctl -j activewindow | jq -r '.["stableId"]')
        grim -T $active_window - | tee ~/pictures/screenshots/$(timestamp-filename) | wl-copy
        ;;
    $display)
        active_monitor=$(hyprctl -j activeworkspace | jq -r '.["monitor"]')
        grim -o $active_monitor - | tee ~/pictures/screenshots/$(timestamp-filename) | wl-copy
        ;;
    $rectangle)
        # grim -g "$(slurp)" - | swappy -f -
        grim -g "$(slurp)" - | tee ~/pictures/screenshots/$(timestamp-filename) | wl-copy
        ;;
    $colorpicker)
        hyprpicker --autocopy --lowercase-hex --radius=150
        ;;
esac
