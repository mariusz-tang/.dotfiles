#!/usr/bin/zsh

darkman='[d]arkman'
theme='[t]heme'
swappy='[a]nnotate last screenshot'
selected_option=$(rofi-menu "utilities" $darkman $theme $swappy)

case $selected_option in
    $darkman)
        darkman toggle
        ;;
    $theme)
        # Reapply the current theme. Should be used after executing `yolk git` commands.
        ~/.config/yolk/eggs/darkman/set-theme $(darkman get)
        ;;
    $swappy)
        wl-paste | swappy -f -
        ;;
esac
